page {
  min-height: 100%;
  color: #302633;
  background: #fff4f8;
  font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button::after {
  border: 0;
}

view,
text,
input,
button {
  box-sizing: border-box;
  font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;
}
